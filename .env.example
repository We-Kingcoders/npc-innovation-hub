# =====================================================
# npc-innovation-hub (frontend) — environment variable template
# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.
# Vite only exposes variables prefixed with VITE_ to client code.
# =====================================================

VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
# Separate FastAPI-based chatbot service used by the Hub-info help widget
# (not the main backend above). Leave unset for local dev if you're not
# running that service.
VITE_CHATBOT_API_URL=http://localhost:8000
