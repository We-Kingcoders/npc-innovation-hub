# =====================================================
# npc-innovation-hub (frontend) — environment variable template
# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.
# Vite only exposes variables prefixed with VITE_ to client code.
# =====================================================

VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
# The NPC AI Assistant (Hub-info/Help.tsx) talks to the real backend
# above (POST /api/assistant/chat) - no separate frontend-configured URL
# needed for it.
